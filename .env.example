# 复制为 .env 后填写。留空时会自动回退到 ~/.hermes/.env 里的 ARK_API_KEY。
MINI_AGENT_API_KEY=
MINI_AGENT_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
MINI_AGENT_MODEL=deepseek-v4.1-flash-economy
# 上下文窗口（token）。DeepSeek-V4.1-Flash 原生 1M 输入
MINI_AGENT_CONTEXT_WINDOW=1000000
MINI_AGENT_COMPACT_RATIO=0.7
# 压缩时尾部保留的 token 预算
MINI_AGENT_KEEP_RECENT_TOKENS=20000
# 单次响应输出预算（思维链 + 正文 + 工具参数共享）。
# 模型普遍长思考 + 一次写大文件，给小了会被 finish_reason=length 截断参数
MINI_AGENT_MAX_OUTPUT_TOKENS=32768
# 是否在终端打印思维链（1 开 / 0 关）
MINI_AGENT_SHOW_REASONING=1
# 工作目录。Edit/Write 与 run_command 的 cwd 限制在此目录内；
# Read/Glob/Grep 可以读取任意路径。
MINI_AGENT_WORKDIR=.
# 可选：
# MINI_AGENT_MAX_STEPS=40
# MINI_AGENT_ENABLE_SHELL=1
# MINI_AGENT_ENABLE_SUBAGENT=1
# MINI_AGENT_SHELL=auto          # auto / gitbash / cmd
# MINI_AGENT_BASH=               # bash.exe 路径，也认 GIT_BASH
# MINI_AGENT_RG_ALL=1            # Glob/Grep 搜索隐藏文件并忽略 .gitignore
# MINI_AGENT_DB=                 # 默认 <项目根>/.mini_agent/sessions.db
# MINI_AGENT_VISION=             # 空：按模型名判断。默认 deepseek-v4.1-flash-economy 会附图。0 强制不附
